# Momentum — environment variables
# Copy to apps/web/.env.local for local development. Never commit real values.

# --- Supabase ----------------------------------------------------------------
# Local: printed by `supabase start` (or `supabase status`). Hosted: Project
# Settings → API. Start the stack with `pnpm db:start`, then `pnpm db:reset` to
# apply the migrations and load the seed.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Browser-safe publishable key (sb_publishable_…). The legacy `anon` JWT also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_… or the legacy `service_role` JWT).
# Used ONLY by seed scripts and integration tests. Never imported by app code
# that can reach the browser; never used in a request path (docs/ARCHITECTURE.md §12).
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------------
# Canonical public origin. Used to build auth redirect URLs (password reset, OAuth).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Tests -------------------------------------------------------------------
# Set to 1 to run the database integration suite (RLS cross-user proofs and the
# signup trigger) against the local Supabase stack. Unset → those tests skip
# themselves, so `pnpm test` stays green without Docker. `pnpm test:db` sets it
# for you and reads the local URL and keys from `supabase status`.
MOMENTUM_DB_TESTS=0
